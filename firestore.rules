rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pending bot-gateway mutations. The Admin SDK writes these.
    // Client SDKs must not read or edit them: editing a pending record
    // would change the write Abi confirms.
    match /botGatewayConfirmations/{docId} {
      allow read, write: if false;
    }

    // Gearshift client SDK access is Abi's Firebase Auth uid only.
    // Axis bots do not use this path; bot_gateway uses the Admin SDK,
    // which bypasses these rules.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == '1SORgD4xeFYG5hMRAmPjw6iUyJk2'
        && collection != 'botGatewayConfirmations';
    }
  }
}
