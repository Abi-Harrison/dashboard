rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pending bot-gateway mutations. The Admin SDK writes these.
    // Client SDKs must not read or edit them: editing a pending record
    // would change the write Abi confirms.
    match /botGatewayConfirmations/{docId} {
      allow read, write: if false;
    }

    // Every other document still requires a signed-in Firebase user.
    // This is a single-user personal app.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && collection != 'botGatewayConfirmations';
    }
  }
}
